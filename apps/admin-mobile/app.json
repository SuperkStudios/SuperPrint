{
  "expo": {
    "name": "SuperPrint Admin",
    "slug": "superprint-admin",
    "scheme": "superprint-admin",
    "version": "0.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/superprint-compact-lockup-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "7",
      "bundleIdentifier": "studio.superk.superprint.admin",
      "associatedDomains": [
        "webcredentials:print.superk.studio",
        "applinks:print.superk.studio"
      ],
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "com.apple.developer.proximity-reader.payment.acceptance": true
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "100.67.193.37": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.0",
              "NSIncludesSubdomains": true
            },
            "keenans-mac-mini.tail95b9d8.ts.net": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.0",
              "NSIncludesSubdomains": true
            }
          }
        },
        "NSFaceIDUsageDescription": "Face ID protects access to the SuperPrint admin console.",
        "NSLocationWhenInUseUsageDescription": "Location access is required for Stripe Terminal readers and Tap to Pay.",
        "NSBluetoothAlwaysUsageDescription": "Bluetooth is used to connect to supported Stripe readers.",
        "NSBluetoothPeripheralUsageDescription": "Bluetooth is used to connect to supported Stripe readers.",
        "NFCReaderUsageDescription": "NFC is used for Tap to Pay on supported iPhones."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID protects access to the SuperPrint admin console."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.studio.superk.superprint",
          "enableGooglePay": false
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothPeripheralPermission": "Bluetooth is used to connect to supported Stripe readers.",
          "bluetoothAlwaysUsagePermission": "Bluetooth is used to connect to supported Stripe readers.",
          "locationWhenInUsePermission": "Location access is required for Stripe Terminal readers and Tap to Pay."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "production",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
