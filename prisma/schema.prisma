generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CUSTOMER
  ADMIN
  STAFF
}

enum MerchantApplicationStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum MerchantBusinessType {
  SOLE_PROPRIETORSHIP
  LLC
  CORPORATION
  PARTNERSHIP
  NONPROFIT
  OTHER
}

enum MerchantTaxIdType {
  EIN
  SSN
}

enum MerchantDocumentType {
  BUSINESS_LICENSE
  TAX_DOCUMENT
  IDENTITY_DOCUMENT
  ADDRESS_VERIFICATION
  OTHER
}

enum MerchantConnectStatus {
  NOT_STARTED
  ACCOUNT_CREATED
  ONBOARDING_STARTED
  RESTRICTED
  ENABLED
  FAILED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum PricingMode {
  FIXED
  DYNAMIC
}

enum UploadStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  CHECKOUT_READY
  PAID
  QUEUED
  PRINTING
  COMPLETED
  STOPPED
  FAILED
  CANCELED
}

enum RewardTransactionType {
  EARNED
  REDEEM_RESERVED
  REDEEMED
  RESERVATION_RELEASED
  ADJUSTMENT
}

enum RewardTransactionStatus {
  PENDING
  POSTED
  VOID
}

enum PrintJobStatus {
  QUEUED
  READY_ON_NODE
  AWAITING_OPERATOR_START
  PRINTING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
  CANCELED
}

enum PrinterStatus {
  HEALTHY
  WARNING
  OFFLINE
  MAINTENANCE
}

enum HeartbeatStatus {
  UNKNOWN
  ONLINE
  STALE
  OFFLINE
}

enum CameraStatus {
  UNKNOWN
  ONLINE
  OFFLINE
}

enum FilamentMaterial {
  PLA
  PLA_PLUS
  PETG
  ABS
  ASA
  TPU
  NYLON
  RESIN
  CARBON_FIBER_PETG
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum SupportTicketStatus {
  OPEN
  AWAITING_ADMIN
  AWAITING_CUSTOMER
  CLOSED
}

enum SliceJobStatus {
  PENDING
  RUNNING
  READY
  BLOCKED
  FAILED
  CANCELED
}

enum ProductionPlateJobStatus {
  PLANNED
  SLICING
  READY
  NEEDS_FILAMENT
  PRINTING
  PRINTED
  INVENTORIED
  CANCELED
  FAILED
}

enum PlatformEventType {
  ORDER_CREATED
  MODEL_UPLOADED
  MODEL_APPROVED
  MODEL_REJECTED
  SLICING_BLOCKED
  SLICING_FAILED
  SLICING_COMPLETE
  QUEUE_ADMITTED
  JOB_READY_ON_NODE
  OPERATOR_PRINT_START_APPROVED
  PRINT_COMMAND_ACKNOWLEDGED
  PRINT_STARTED
  PRINT_PAUSED
  PRINT_REQUEUED
  MANUAL_PRINT_DETECTED
  PRINT_COMPLETED
  PRINT_STOPPED
  PRINT_FAILED
  FILAMENT_LOW
  MAINTENANCE_DUE
  VIDEO_READY
  FACTORY_CONTRIBUTION_CREATED
  FACTORY_GOAL_FUNDED
  FACTORY_GOAL_COMPLETED
  FACTORY_SUPPORTER_JOINED
  FACTORY_MILESTONE_COMPLETED
  FACTORY_UPGRADE_UNLOCKED
}

enum FactoryUpgradeCategory {
  printer
  material
  camera
  automation
  facility
  livestream
  quality
  experimental
}

enum FactoryUpgradeStatus {
  active
  funded
  installing
  completed
  cancelled
}

enum FactoryVisibility {
  public
  private
}

enum FactoryActivityType {
  CONTRIBUTION_CREATED
  GOAL_FUNDED
  GOAL_INSTALLING
  GOAL_COMPLETED
  SUPPORTER_JOINED
  MILESTONE_COMPLETED
  UPGRADE_UNLOCKED
  MANUAL_PROGRESS_ADJUSTED
}

enum FactoryMilestoneMetric {
  completed_prints
  filament_grams
  queue_watch_hours
  printer_uptime_hours
  contribution_cents
  livestream_engagement
  custom
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  emailVerified Boolean      @default(false)
  image        String?
  username     String?       @unique
  bio          String?
  shippingName String?
  shippingStreet1 String?
  shippingStreet2 String?
  shippingCity String?
  shippingState String?
  shippingZip String?
  shippingCountry String?    @default("US")
  shippingPhone String?
  stripeCustomerId String?    @unique
  passwordHash String?
  role         UserRole      @default(CUSTOMER)
  staffPermissions Json      @default("[]")
  rewardsPointsBalance Int   @default(0)
  sessions     Session[]
  accounts     Account[]
  carts        Cart[]
  uploads      ModelUpload[]
  orders       Order[]
  productPartInventoryUpdates ProductPartInventory[]
  supportTickets SupportTicket[] @relation("SupportTicketCustomer")
  supportMessages SupportTicketMessage[] @relation("SupportMessageAuthor")
  rewardTransactions RewardTransaction[]
  factoryContributions FactoryContribution[]
  supporterProfile UserSupporterProfile?
  merchantApplications MerchantApplication[]
  merchantProducts MerchantProduct[]
  merchantOrders MerchantOrder[]
  events       PlatformEvent[]
  operatorPrintStarts PrintJob[] @relation("OperatorPrintStarts")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model MerchantApplication {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              MerchantApplicationStatus @default(DRAFT)
  businessName        String
  legalBusinessName   String?
  businessType        MerchantBusinessType
  siteUrl             String
  ownerName           String
  ownerEmail          String
  phone               String
  street1             String
  street2             String?
  city                String
  state               String
  zip                 String
  country             String                    @default("US")
  taxIdType           MerchantTaxIdType
  taxIdLast4          String
  encryptedTaxId      Json?
  stripeConnectStatus MerchantConnectStatus      @default(NOT_STARTED)
  stripeAccountId     String?
  stripeTerminalLocationId String?
  stripeChargesEnabled Boolean                   @default(false)
  stripePayoutsEnabled Boolean                   @default(false)
  stripeDetailsSubmitted Boolean                 @default(false)
  stripeRequirementsDue Json                     @default("[]")
  reviewNotes         String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  documents           MerchantDocument[]
  products            MerchantProduct[]
  orders              MerchantOrder[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([userId, status])
  @@index([status, updatedAt])
}

model MerchantDocument {
  id             String               @id @default(cuid())
  applicationId  String
  application    MerchantApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type           MerchantDocumentType
  fileName       String
  storageKey     String
  contentType    String
  fileSizeBytes  Int
  uploadedAt     DateTime             @default(now())

  @@index([applicationId, uploadedAt])
}

model MerchantProduct {
  id             String               @id @default(cuid())
  merchantUserId String
  merchantUser   User                 @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    MerchantApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name           String
  priceCents     Int
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  orders         MerchantOrder[]

  @@index([merchantUserId, active])
}

model MerchantOrder {
  id                    String               @id @default(cuid())
  merchantUserId        String
  merchantUser          User                 @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)
  applicationId         String?
  application           MerchantApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  productId             String?
  product               MerchantProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerEmail         String
  itemSummary           String
  amountCents           Int
  status                String               @default("PENDING")
  receiptUrl            String?
  stripePaymentIntentId String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([merchantUserId, createdAt])
}

model SupportTicket {
  id           String              @id @default(cuid())
  ticketNumber String             @unique
  customerId   String
  customer     User               @relation("SupportTicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  subject      String
  status       SupportTicketStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  closedAt     DateTime?
  messages     SupportTicketMessage[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([customerId, updatedAt])
  @@index([status, updatedAt])
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorType String
  body      String
  channel   String        @default("UI")
  emailFrom String?
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model FactoryUpgradeGoal {
  id                 String                 @id @default(cuid())
  slug               String                 @unique
  title              String
  description        String
  category           FactoryUpgradeCategory
  status             FactoryUpgradeStatus   @default(active)
  visibility         FactoryVisibility      @default(public)
  targetAmountCents  Int
  currentAmountCents Int                    @default(0)
  contributionCount  Int                    @default(0)
  unlockBenefits     Json                   @default("[]")
  imageUrl           String?
  displayOrder       Int                    @default(0)
  featured           Boolean                @default(false)
  contributions      FactoryContribution[]
  activities         FactoryActivityEvent[]
  unlockedUpgrades   FactoryUnlockedUpgrade[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  completedAt        DateTime?

  @@index([visibility, status, displayOrder])
  @@index([featured, displayOrder])
}

model FactoryContribution {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId                String
  goal                  FactoryUpgradeGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amountCents           Int
  message               String?
  anonymous             Boolean             @default(false)
  stripeCheckoutSessionId String?           @unique
  stripePaymentIntentId String?             @unique
  paymentStatus         String              @default("manual")
  createdAt             DateTime            @default(now())

  @@index([goalId, createdAt])
  @@index([userId, createdAt])
}

model SupporterTier {
  id                String                  @id @default(cuid())
  slug              String                  @unique
  title             String
  description       String                  @default("")
  monthlyPriceCents Int?
  oneTimePriceCents Int?
  perks             Json                    @default("[]")
  badgeIcon         String
  badgeColor        String
  priorityWeight    Float                   @default(1)
  displayOrder      Int                     @default(0)
  active            Boolean                 @default(true)
  profiles          UserSupporterProfile[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model UserSupporterProfile {
  userId                    String          @id
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId                    String?
  tier                      SupporterTier?   @relation(fields: [tierId], references: [id], onDelete: SetNull)
  lifetimeContributionCents Int             @default(0)
  badges                    Json            @default("[]")
  supporterSince            DateTime        @default(now())
  founder                   Boolean         @default(false)
  queuePriorityMultiplier   Float           @default(1)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model FactoryMilestone {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  description   String
  metric        FactoryMilestoneMetric @default(custom)
  targetValue   Int
  currentValue  Int                    @default(0)
  unitLabel     String                 @default("")
  visibility    FactoryVisibility      @default(public)
  completed     Boolean                @default(false)
  displayOrder  Int                    @default(0)
  activities    FactoryActivityEvent[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  completedAt   DateTime?

  @@index([visibility, completed, displayOrder])
}

model FactoryActivityEvent {
  id        String              @id @default(cuid())
  type      FactoryActivityType
  title     String
  body      String?
  goalId    String?
  goal      FactoryUpgradeGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone FactoryMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  actorName String?
  amountCents Int?
  public    Boolean             @default(true)
  metadata  Json                @default("{}")
  createdAt DateTime            @default(now())

  @@index([public, createdAt])
  @@index([type, createdAt])
}

model FactoryUnlockedUpgrade {
  id          String              @id @default(cuid())
  goalId      String?
  goal        FactoryUpgradeGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title       String
  description String
  category    FactoryUpgradeCategory
  imageUrl    String?
  displayOrder Int                @default(0)
  public      Boolean             @default(true)
  unlockedAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([public, unlockedAt])
}

model FactoryStat {
  id           String            @id @default(cuid())
  key          String            @unique
  label        String
  value        String
  unit         String?
  description  String?
  icon         String            @default("gauge")
  displayOrder Int               @default(0)
  visibility   FactoryVisibility @default(public)
  updatedAt    DateTime          @updatedAt
  createdAt    DateTime          @default(now())
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Product {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  name                 String
  description          String
  imageUrl             String
  imageStorageKey      String?
  productFileStorageKey String?
  previewPlateStorageKey String?
  baseModelFile        String?
  defaultFilamentMaterialId String?
  defaultFilamentMaterial FilamentSpool? @relation("DefaultProductFilament", fields: [defaultFilamentMaterialId], references: [id])
  baseLaborMinutes     Int           @default(10)
  basePackagingCents   Int           @default(150)
  shippingPackagePreset String        @default("polymailer_4x8")
  shippingParcelTemplateId String?
  shippingPackageLengthIn Float       @default(8)
  shippingPackageWidthIn  Float       @default(4)
  shippingPackageHeightIn Float       @default(1)
  shippingPackageWeightOz Float       @default(8)
  priceCents           Int
  pricingMode          PricingMode   @default(FIXED)
  fixedPriceCents      Int?
  estimatedPrintMinutes Int
  estimatedGrams       Int           @default(1)
  materialCostCents    Int           @default(0)
  defaultMaterial      FilamentMaterial
  colorSlotCount       Int           @default(1)
  maxBatchQuantity     Int           @default(1)
  status               ProductStatus @default(ACTIVE)
  allowedFilaments     ProductAllowedFilament[]
  parts                ProductPart[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  orders               Order[]
  pricingSnapshots     OrderPricingSnapshot[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model ProductPart {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  fileStorageKey  String
  role            String   @default("part")
  colorSlotIndex  Int      @default(0)
  colorSlotPattern Int[]    @default([])
  quantityPerUnit Int      @default(1)
  displayOrder    Int      @default(0)
  inventory       ProductPartInventory[]
  productionPlateJobs ProductionPlateJob[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId, displayOrder])
}

model ProductionPlateJob {
  id                    String                   @id @default(cuid())
  productPartId          String
  productPart            ProductPart              @relation(fields: [productPartId], references: [id], onDelete: Cascade)
  filamentId             String?
  filament               FilamentSpool?           @relation(fields: [filamentId], references: [id], onDelete: SetNull)
  color                  String
  status                 ProductionPlateJobStatus @default(PLANNED)
  quantityPlanned        Int
  requiredQuantity       Int
  inventoryUsedQuantity  Int                      @default(0)
  maxPerPlate            Int
  plateIndex             Int                      @default(1)
  plateCount             Int                      @default(1)
  orderRefs              Json                     @default("[]")
  inputStorageKey        String
  outputStorageKey       String?
  nodeLocalJobPath       String?
  slicerMessage          String?
  estimatedPrintMinutes  Int?
  estimatedGrams         Int?
  lastError              String?
  printedQuantity        Int                      @default(0)
  inventoriedQuantity    Int                      @default(0)
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([color, status])
  @@index([productPartId, color])
}

model ProductPartInventory {
  id              String      @id @default(cuid())
  productPartId   String
  productPart     ProductPart @relation(fields: [productPartId], references: [id], onDelete: Cascade)
  color           String
  quantityOnHand  Int         @default(0)
  location        String      @default("Storage")
  notes           String?
  updatedById     String?
  updatedBy       User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([productPartId, color, location])
  @@index([color])
}

model ProductAllowedFilament {
  id                            String         @id @default(cuid())
  productId                     String
  product                       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  filamentMaterialId            String
  filamentMaterial              FilamentSpool  @relation(fields: [filamentMaterialId], references: [id], onDelete: Cascade)
  estimatedGramsOverride        Int?
  estimatedPrintMinutesOverride Int?
  priceAdjustmentCents          Int            @default(0)
  enabled                       Boolean        @default(true)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  @@unique([productId, filamentMaterialId])
  @@index([filamentMaterialId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String     @default("ACTIVE")
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, status])
}

model CartItem {
  id                         String         @id @default(cuid())
  cartId                     String
  cart                       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId                  String
  product                    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity                   Int            @default(1)
  selectedMaterial           FilamentMaterial?
  selectedColor              String?
  selectedFilamentMaterialId String?
  selectedFilamentMaterial   FilamentSpool? @relation("CartItemSelectedFilament", fields: [selectedFilamentMaterialId], references: [id])
  selectedFilamentMaterialIds Json          @default("[]")
  selectedColors             Json          @default("[]")
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([selectedFilamentMaterialId])
}

model ModelUpload {
  id                  String       @id @default(cuid())
  customerId          String
  customer            User         @relation(fields: [customerId], references: [id])
  fileName            String
  storageKey          String
  checksumSha256      String?
  fileSizeBytes       Int?
  contentType         String?
  notes               String?
  adminNotes          String?
  status              UploadStatus @default(PENDING)
  rejectionReason     String?
  approvedById        String?
  approvedAt          DateTime?
  estimatedPriceCents Int?
  estimatedGrams      Int?
  estimatedPrintMinutes Int?
  selectedMaterial    FilamentMaterial?
  selectedPrinterId   String?
  selectedPrinter     Printer?     @relation(fields: [selectedPrinterId], references: [id])
  orders              Order[]
  sliceJobs           SliceJob[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerId     String
  customer       User        @relation(fields: [customerId], references: [id])
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id])
  uploadId       String?
  upload         ModelUpload? @relation(fields: [uploadId], references: [id])
  status         OrderStatus @default(CHECKOUT_READY)
  totalCents     Int
  subtotalCents  Int         @default(0)
  taxCents       Int         @default(0)
  paymentFeeCents Int       @default(0)
  paymentStatus  String      @default("PENDING")
  paymentMethod  String      @default("UNPAID")
  paymentSource  String?
  amountPaidCents Int        @default(0)
  depositCents   Int         @default(0)
  balanceDueCents Int        @default(0)
  paymentReference String?
  cardBrand      String?
  cardLast4      String?
  paidAt         DateTime?
  orderSource    String      @default("ONLINE")
  internalNotes  String?
  stripePaymentIntentId String? @unique
  shippingStatus String      @default("NOT_STARTED")
  fulfillmentMethod String   @default("SHIP")
  shippingName   String?
  shippingStreet1 String?
  shippingStreet2 String?
  shippingCity   String?
  shippingState  String?
  shippingZip    String?
  shippingCountry String?    @default("US")
  shippingPhone  String?
  shippingEmail  String?
  shippoShipmentId String?
  shippoRateId   String?
  shippoTransactionId String?
  shippingProvider String?
  shippingService String?
  shippingRateCents Int      @default(0)
  shippingAmountCents Int    @default(0)
  rewardPointsRedeemed Int   @default(0)
  rewardDiscountCents Int    @default(0)
  rewardPointsEarned Int     @default(0)
  shippingLabelUrl String?
  trackingNumber String?
  trackingUrl    String?
  labelPrintedAt DateTime?
  selectedMaterial FilamentMaterial?
  selectedColor   String?
  selectedFilamentMaterialId String?
  selectedFilamentMaterial FilamentSpool? @relation("OrderSelectedFilament", fields: [selectedFilamentMaterialId], references: [id])
  selectedFilamentMaterialIds Json          @default("[]")
  selectedColors             Json          @default("[]")
  items          OrderItem[]
  pricingSnapshot OrderPricingSnapshot?
  printJobs      PrintJob[]
  videos         OrderVideo[]
  rewardTransactions RewardTransaction[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id                         String         @id @default(cuid())
  orderId                    String
  order                      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                  String
  product                    Product        @relation(fields: [productId], references: [id])
  quantity                   Int            @default(1)
  unitPriceCents             Int
  subtotalCents              Int
  taxCents                   Int            @default(0)
  paymentFeeCents            Int            @default(0)
  totalCents                 Int
  estimatedGrams             Int
  estimatedPrintMinutes      Int
  selectedMaterial           FilamentMaterial?
  selectedColor              String?
  selectedFilamentMaterialId String?
  selectedFilamentMaterial   FilamentSpool? @relation("OrderItemSelectedFilament", fields: [selectedFilamentMaterialId], references: [id])
  selectedFilamentMaterialIds Json          @default("[]")
  selectedColors             Json          @default("[]")
  createdAt                  DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([selectedFilamentMaterialId])
}

model RewardTransaction {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        RewardTransactionType
  status      RewardTransactionStatus @default(POSTED)
  points      Int
  centsBasis  Int                     @default(0)
  description String
  expiresAt   DateTime?
  finalizedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([orderId, type])
  @@index([status, expiresAt])
}

model Printer {
  id                 String        @id @default(cuid())
  name               String
  publicName         String
  modelName          String        @default("Elegoo Centauri Carbon")
  nozzleSizeMm       Float         @default(0.4)
  buildVolumeXmm     Int           @default(256)
  buildVolumeYmm     Int           @default(256)
  buildVolumeZmm     Int           @default(256)
  supportedMaterials Json          @default("[\"PLA\",\"PETG\"]")
  status             PrinterStatus @default(HEALTHY)
  healthDescription  String
  internalIp         String
  controlApiUrl      String
  currentFilamentId  String?
  currentFilament    FilamentSpool? @relation(fields: [currentFilamentId], references: [id])
  cameraSource       String?
  cameraStatus       CameraStatus  @default(UNKNOWN)
  maintenanceProfile String        @default("Elegoo Centauri Carbon standard maintenance")
  totalRuntimeMinutes Int          @default(0)
  completedPrintCount Int          @default(0)
  failedPrintCount   Int           @default(0)
  heartbeatStatus    HeartbeatStatus @default(UNKNOWN)
  lastHeartbeatAt    DateTime?
  heartbeatLatencyMs Int?
  superNodes         SuperNode[]
  jobs               PrintJob[]
  selectedUploads    ModelUpload[]
  maintenanceTasks   MaintenanceTask[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model SuperNode {
  id                  String          @id @default(cuid())
  nodeId              String          @unique
  displayName         String
  secretHash          String
  printerId           String?
  printer             Printer?        @relation(fields: [printerId], references: [id])
  heartbeatStatus     HeartbeatStatus @default(UNKNOWN)
  printerStatus       PrinterStatus   @default(OFFLINE)
  cameraStatus        CameraStatus    @default(UNKNOWN)
  localUploadPath     String?
  localSlicedPath     String?
  localVideoPath      String?
  localTimelapsePath  String?
  localThumbnailPath  String?
  lastHeartbeatAt     DateTime?
  lastError           String?
  retryCount          Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([heartbeatStatus, lastHeartbeatAt])
}

model PrintJob {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  printerId      String?
  printer        Printer?       @relation(fields: [printerId], references: [id])
  filamentId     String?
  filament       FilamentSpool? @relation(fields: [filamentId], references: [id])
  sliceJobId     String?
  sliceJob       SliceJob?      @relation(fields: [sliceJobId], references: [id])
  status         PrintJobStatus @default(QUEUED)
  queuePosition  Int?
  etaMinutes     Int
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?
  streamUrl      String?
  queueLockedAt  DateTime?
  queueLockToken String?
  assignedAt     DateTime?
  assignmentBlockedReason String?
  reservedFilamentGrams Int?
  consumedFilamentGrams Int?
  readyOnNodeAt  DateTime?
  readyOnNodeId  String?
  nodeLocalJobPath String?
  operatorStartApprovedById String?
  operatorStartApprovedBy   User?   @relation("OperatorPrintStarts", fields: [operatorStartApprovedById], references: [id])
  operatorStartApprovedAt DateTime?
  operatorStartChecklist Json?
  printCommandAcknowledgedAt DateTime?
  printCommandAcknowledgedByNodeId String?
  currentLayer   Int?
  progressPercent Int?
  elapsedSeconds Int?
  remainingSeconds Int?
  nozzleTempC    Float?
  bedTempC       Float?
  telemetryUpdatedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, queuePosition])
  @@index([queueLockToken])
}

model SlicerProfile {
  id          String     @id @default(cuid())
  name        String
  description String
  profilePath String
  isDefault   Boolean    @default(false)
  sliceJobs   SliceJob[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MachineProfile {
  id          String     @id @default(cuid())
  name        String
  modelName   String
  profilePath String
  sliceJobs   SliceJob[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model FilamentProfile {
  id          String           @id @default(cuid())
  name        String
  material    FilamentMaterial
  profilePath String
  sliceJobs   SliceJob[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SliceJob {
  id                String          @id @default(cuid())
  uploadId          String
  upload            ModelUpload     @relation(fields: [uploadId], references: [id])
  slicerProfileId   String
  slicerProfile     SlicerProfile   @relation(fields: [slicerProfileId], references: [id])
  machineProfileId  String
  machineProfile    MachineProfile  @relation(fields: [machineProfileId], references: [id])
  filamentProfileId String
  filamentProfile   FilamentProfile @relation(fields: [filamentProfileId], references: [id])
  status            SliceJobStatus   @default(PENDING)
  inputStorageKey   String
  outputStorageKey  String?
  watchedFolderPath String?
  commandPreview    Json
  estimatedPrintMinutes Int?
  estimatedGrams    Int?
  warnings          Json?
  errorLog          String?
  stdoutLog         String?
  stderrLog         String?
  blockedReason     String?
  startedAt         DateTime?
  completedAt       DateTime?
  failureReason     String?
  printJobs         PrintJob[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, createdAt])
}

model WatchedFolder {
  id          String   @id @default(cuid())
  name        String
  folderPath  String
  purpose     String
  enabled     Boolean  @default(true)
  lastScanAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FilamentSpool {
  id             String           @id @default(cuid())
  name           String?
  material       FilamentMaterial
  type           FilamentMaterial  @default(PLA)
  color          String
  brand          String
  startingGrams  Int              @default(1000)
  spoolWeightGrams Int            @default(1000)
  remainingGrams Int
  thresholdGrams Int
  rollCostCents  Int              @default(0)
  costPerSpoolCents Int           @default(0)
  costPerGramCents Float          @default(0)
  markupMultiplier Float          @default(1)
  active         Boolean          @default(true)
  requiresAdminApproval Boolean   @default(false)
  notes          String?
  assignedPrinterHistory Json     @default("[]")
  ignoredPrinterHistory Json      @default("[]")
  location       String
  printers       Printer[]
  jobs           PrintJob[]
  productionPlateJobs ProductionPlateJob[]
  defaultProducts Product[]        @relation("DefaultProductFilament")
  allowedProducts ProductAllowedFilament[]
  cartItems      CartItem[]        @relation("CartItemSelectedFilament")
  selectedOrders  Order[]          @relation("OrderSelectedFilament")
  selectedOrderItems OrderItem[]    @relation("OrderItemSelectedFilament")
  pricingSnapshots OrderPricingSnapshot[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model PricingSettings {
  id                             String   @id @default(cuid())
  machineHourlyRateCents          Int      @default(250)
  laborHourlyRateCents            Int      @default(1800)
  electricityHourlyRateCents      Int      @default(20)
  maintenanceReservePercent       Float    @default(0.08)
  failureReservePercent           Float    @default(0.12)
  defaultProfitMultiplier         Float    @default(2)
  paymentProcessingPercent        Float    @default(0.029)
  paymentProcessingFixedCents     Int      @default(30)
  taxPercentEstimate              Float?
  minimumOrderPriceCents          Int      @default(500)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model OrderPricingSnapshot {
  id                         String        @id @default(cuid())
  orderId                    String        @unique
  order                      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                  String
  product                    Product       @relation(fields: [productId], references: [id])
  filamentMaterialId         String
  filamentMaterial           FilamentSpool @relation(fields: [filamentMaterialId], references: [id])
  materialCostCents          Int
  machineTimeCostCents       Int
  electricityCostCents       Int
  laborCostCents             Int
  packagingCostCents         Int
  maintenanceReserveCents    Int
  failureReserveCents        Int
  subtotalCostCents          Int
  profitMarkupCents          Int
  paymentFeeCents            Int
  taxCents                   Int
  shippingCents              Int
  preRewardCustomerPriceCents Int          @default(0)
  rewardDiscountCents        Int           @default(0)
  finalCustomerPriceCents    Int
  internalCostCents          Int           @default(0)
  marginCents                Int           @default(0)
  marginPercent              Float         @default(0)
  pricingFormulaVersion      String        @default("product-pricing-v1")
  createdAt                  DateTime      @default(now())

  @@index([productId])
  @@index([filamentMaterialId])
}

model MaintenanceTask {
  id          String            @id @default(cuid())
  printerId   String
  printer     Printer           @relation(fields: [printerId], references: [id])
  title       String
  description String
  dueAt       DateTime
  status      MaintenanceStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model OrderVideo {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  title       String
  storageKey  String
  timelapseStorageKey String?
  thumbnailStorageKey String?
  playbackUrl String
  durationSec Int
  createdAt   DateTime @default(now())
}

model PlatformEvent {
  id        String            @id @default(cuid())
  type      PlatformEventType
  actorId   String?
  actor     User?             @relation(fields: [actorId], references: [id])
  payload   Json
  createdAt DateTime          @default(now())

  @@index([type, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
