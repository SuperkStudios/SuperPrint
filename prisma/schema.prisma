generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum UploadStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  CHECKOUT_READY
  PAID
  QUEUED
  PRINTING
  COMPLETED
  FAILED
  CANCELED
}

enum PrintJobStatus {
  QUEUED
  READY_ON_NODE
  PRINTING
  PAUSED
  COMPLETED
  FAILED
  CANCELED
}

enum PrinterStatus {
  HEALTHY
  WARNING
  OFFLINE
  MAINTENANCE
}

enum HeartbeatStatus {
  UNKNOWN
  ONLINE
  STALE
  OFFLINE
}

enum CameraStatus {
  UNKNOWN
  ONLINE
  OFFLINE
}

enum FilamentMaterial {
  PLA
  PETG
  ABS
  TPU
  NYLON
  RESIN
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum SliceJobStatus {
  PENDING
  RUNNING
  READY
  BLOCKED
  FAILED
  CANCELED
}

enum PlatformEventType {
  ORDER_CREATED
  MODEL_UPLOADED
  MODEL_APPROVED
  MODEL_REJECTED
  SLICING_BLOCKED
  SLICING_FAILED
  SLICING_COMPLETE
  QUEUE_ADMITTED
  JOB_READY_ON_NODE
  PRINT_STARTED
  PRINT_PAUSED
  PRINT_REQUEUED
  PRINT_COMPLETED
  PRINT_FAILED
  FILAMENT_LOW
  MAINTENANCE_DUE
  VIDEO_READY
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         UserRole      @default(CUSTOMER)
  uploads      ModelUpload[]
  orders       Order[]
  events       PlatformEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Product {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  name                 String
  description          String
  imageUrl             String
  priceCents           Int
  estimatedPrintMinutes Int
  defaultMaterial      FilamentMaterial
  status               ProductStatus @default(ACTIVE)
  orders               Order[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model ModelUpload {
  id                  String       @id @default(cuid())
  customerId          String
  customer            User         @relation(fields: [customerId], references: [id])
  fileName            String
  storageKey          String
  checksumSha256      String?
  fileSizeBytes       Int?
  contentType         String?
  notes               String?
  adminNotes          String?
  status              UploadStatus @default(PENDING)
  rejectionReason     String?
  approvedById        String?
  approvedAt          DateTime?
  estimatedPriceCents Int?
  estimatedGrams      Int?
  estimatedPrintMinutes Int?
  selectedMaterial    FilamentMaterial?
  selectedPrinterId   String?
  selectedPrinter     Printer?     @relation(fields: [selectedPrinterId], references: [id])
  orders              Order[]
  sliceJobs           SliceJob[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerId     String
  customer       User        @relation(fields: [customerId], references: [id])
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id])
  uploadId       String?
  upload         ModelUpload? @relation(fields: [uploadId], references: [id])
  status         OrderStatus @default(CHECKOUT_READY)
  totalCents     Int
  paymentStatus  String      @default("PENDING")
  shippingStatus String      @default("NOT_STARTED")
  printJobs      PrintJob[]
  videos         OrderVideo[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Printer {
  id                 String        @id @default(cuid())
  name               String
  publicName         String
  modelName          String        @default("Elegoo Centauri Carbon")
  nozzleSizeMm       Float         @default(0.4)
  buildVolumeXmm     Int           @default(256)
  buildVolumeYmm     Int           @default(256)
  buildVolumeZmm     Int           @default(256)
  supportedMaterials Json          @default("[\"PLA\",\"PETG\"]")
  status             PrinterStatus @default(HEALTHY)
  healthDescription  String
  internalIp         String
  controlApiUrl      String
  currentFilamentId  String?
  currentFilament    FilamentSpool? @relation(fields: [currentFilamentId], references: [id])
  cameraSource       String?
  cameraStatus       CameraStatus  @default(UNKNOWN)
  maintenanceProfile String        @default("Elegoo Centauri Carbon standard maintenance")
  totalRuntimeMinutes Int          @default(0)
  completedPrintCount Int          @default(0)
  failedPrintCount   Int           @default(0)
  heartbeatStatus    HeartbeatStatus @default(UNKNOWN)
  lastHeartbeatAt    DateTime?
  heartbeatLatencyMs Int?
  superNodes         SuperNode[]
  jobs               PrintJob[]
  selectedUploads    ModelUpload[]
  maintenanceTasks   MaintenanceTask[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model SuperNode {
  id                  String          @id @default(cuid())
  nodeId              String          @unique
  displayName         String
  secretHash          String
  printerId           String?
  printer             Printer?        @relation(fields: [printerId], references: [id])
  heartbeatStatus     HeartbeatStatus @default(UNKNOWN)
  printerStatus       PrinterStatus   @default(OFFLINE)
  cameraStatus        CameraStatus    @default(UNKNOWN)
  localUploadPath     String?
  localSlicedPath     String?
  localVideoPath      String?
  localTimelapsePath  String?
  localThumbnailPath  String?
  lastHeartbeatAt     DateTime?
  lastError           String?
  retryCount          Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([heartbeatStatus, lastHeartbeatAt])
}

model PrintJob {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id])
  printerId      String?
  printer        Printer?       @relation(fields: [printerId], references: [id])
  filamentId     String?
  filament       FilamentSpool? @relation(fields: [filamentId], references: [id])
  sliceJobId     String?
  sliceJob       SliceJob?      @relation(fields: [sliceJobId], references: [id])
  status         PrintJobStatus @default(QUEUED)
  queuePosition  Int?
  etaMinutes     Int
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?
  streamUrl      String?
  queueLockedAt  DateTime?
  queueLockToken String?
  assignedAt     DateTime?
  assignmentBlockedReason String?
  reservedFilamentGrams Int?
  readyOnNodeAt  DateTime?
  readyOnNodeId  String?
  nodeLocalJobPath String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, queuePosition])
  @@index([queueLockToken])
}

model SlicerProfile {
  id          String     @id @default(cuid())
  name        String
  description String
  profilePath String
  isDefault   Boolean    @default(false)
  sliceJobs   SliceJob[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MachineProfile {
  id          String     @id @default(cuid())
  name        String
  modelName   String
  profilePath String
  sliceJobs   SliceJob[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model FilamentProfile {
  id          String           @id @default(cuid())
  name        String
  material    FilamentMaterial
  profilePath String
  sliceJobs   SliceJob[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SliceJob {
  id                String          @id @default(cuid())
  uploadId          String
  upload            ModelUpload     @relation(fields: [uploadId], references: [id])
  slicerProfileId   String
  slicerProfile     SlicerProfile   @relation(fields: [slicerProfileId], references: [id])
  machineProfileId  String
  machineProfile    MachineProfile  @relation(fields: [machineProfileId], references: [id])
  filamentProfileId String
  filamentProfile   FilamentProfile @relation(fields: [filamentProfileId], references: [id])
  status            SliceJobStatus   @default(PENDING)
  inputStorageKey   String
  outputStorageKey  String?
  watchedFolderPath String?
  commandPreview    Json
  estimatedPrintMinutes Int?
  estimatedGrams    Int?
  warnings          Json?
  errorLog          String?
  stdoutLog         String?
  stderrLog         String?
  blockedReason     String?
  startedAt         DateTime?
  completedAt       DateTime?
  failureReason     String?
  printJobs         PrintJob[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, createdAt])
}

model WatchedFolder {
  id          String   @id @default(cuid())
  name        String
  folderPath  String
  purpose     String
  enabled     Boolean  @default(true)
  lastScanAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FilamentSpool {
  id             String           @id @default(cuid())
  material       FilamentMaterial
  color          String
  brand          String
  remainingGrams Int
  thresholdGrams Int
  location       String
  printers       Printer[]
  jobs           PrintJob[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model MaintenanceTask {
  id          String            @id @default(cuid())
  printerId   String
  printer     Printer           @relation(fields: [printerId], references: [id])
  title       String
  description String
  dueAt       DateTime
  status      MaintenanceStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model OrderVideo {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  title       String
  storageKey  String
  timelapseStorageKey String?
  thumbnailStorageKey String?
  playbackUrl String
  durationSec Int
  createdAt   DateTime @default(now())
}

model PlatformEvent {
  id        String            @id @default(cuid())
  type      PlatformEventType
  actorId   String?
  actor     User?             @relation(fields: [actorId], references: [id])
  payload   Json
  createdAt DateTime          @default(now())

  @@index([type, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
